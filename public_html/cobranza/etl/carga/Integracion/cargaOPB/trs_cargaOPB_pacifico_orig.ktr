        <jsScript_script>//Script here

var carteraEtl_cedula=IDENTIFICACION;

if (carteraEtl_cedula.length==9){
	carteraEtl_cedula='0'+ carteraEtl_cedula;
}
else if (carteraEtl_cedula.length==12){
	carteraEtl_cedula='0'+ carteraEtl_cedula;
}


var nombreCompleto = nombre1 + ' ' + nombre2 + ' ' + apellido1 + ' ' +apellido2;


var diaCorte = FECHA_CUOTA_POR_VENCER.slice(8,10);

var carteraEtl_fechaCarga=new Date().getTime() / 1000;
//var fechaMaxima = new Date (Fechamax*1000);
//var fechaMaxima = new Date(FECHA_CUOTA_POR_VENCER).getTime() / 1000; 

var fechaMaxima = new Date((FECHA_CUOTA_POR_VENCER - 25569) * 86400 * 1000);
	fechaMaxima = new Date(fechaMaxima.getTime() + (new Date().getTimezoneOffset() * 60000));

var fechaVencimiento = new Date(fechaMaxima).getTime() / 1000; 

var carteraEtl_telefonoLimpiar = TELEF_DOMILICIO + ' ' + TELEF_TRABAJO + ' ' + TELEF_CELULAR;

var carteraEtl_marca = '';
if (TIPO_CREDITO=="EDU"){
	carteraEtl_marca = "EDUCATIVO";
}
else if (TIPO_CREDITO=="VIP"){
	carteraEtl_marca = "VIP";
}
else if (TIPO_CREDITO=="MIC"){
	carteraEtl_marca = "MICROCREDITO";
}
else if (TIPO_CREDITO=="CON"){
	carteraEtl_marca = "CONSUMO";
}
else if (TIPO_CREDITO=="VIV"){
	carteraEtl_marca = "INMOBILIARIO";
}

var carteraEtl_procesado = 999;
var carteraEtl_estado = 1;
var carteraEtl_carteraId = "2122";
var carteraEtl_carteraNombre = "BANCO DEL PACIFICO OPB";
var carteraEtl_producto = carteraEtl_marca;
var carteraEtl_capitalPorVencer = 0;
var carteraEtl_saldoCapital = VALOR_VENCIDO;
var carteraEtl_deudaOriginal = 0;
var carteraEtl_agente = 'NA';
var carteraEtl_ciudad = 'NA';
</jsScript_script>
