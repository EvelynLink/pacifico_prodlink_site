      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

var secuenciaGestion = lpad(secuenciaLlamada,'0',2);

//var reporte = rpad(identificacion,' ',16) + rpad(operacion,' ',6) + rpad(fechaAsignacionArchivo,' ',8) + lpad(secuenciaGestion,'0',2) + rpad(fechaGestion3,' ',8) + rpad(tipoContacto,' ',1) + rpad(codCobranzas,' ',2) + rpad(obs1,' ',70) + rpad(obs2,' ',70) + rpad(cualquier,' ',70) + rpad(compromisoPago,' ',8) + rpad(codigoResp,' ',3);

var identificacionCliente = rpad(identificacion,' ',16);
var creditoCliente = rpad(operacion,' ',6);
var fechaAsignaCuenta = rpad(fechaAsignacionArchivo,' ',8);
var numeroContacto = lpad(secuenciaGestion,'0',2); 
var fechaGestionCuenta = rpad(fechaGestion3,' ',8);
var tipoContactoCobranza = rpad(tipoContacto,' ',1);
var codigoRespuestaCobranza = rpad(codCobranzas,'0',2);
var observaciones1 = rpad(obs1,' ',70);
var observaciones2 = rpad(obs2,' ',70);
var observaciones3 = rpad(cualquier,' ',70);

var fechaProximoSeguimiento = rpad(compromisoPago,' ',8);
var codigoDeRespuesta = rpad(codigoResp,' ',3);

var observacionConcat = rpad(obs1 + ' ' + obs2 + ' ' + obs3,' ',210)</jsScript_script>
