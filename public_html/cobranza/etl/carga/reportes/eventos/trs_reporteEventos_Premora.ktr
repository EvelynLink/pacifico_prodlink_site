        <jsScript_script>//Script here

//var fechaAsigna = new Date(av_fecha).getTime() / 1000; 

var fechaAsigna= new Date(parseInt(scLlamadas_fechaCreacion) * 1000);
if (fechaAsigna>0){
	var year = fechaAsigna.getFullYear();
  	var month = fechaAsigna.getMonth()+1;
  	var dia = fechaAsigna.getDate();
// Will display time in 10:30:23 format
	fechaAsigna = year + lpad(month,'0',2) + lpad(dia,'0',2);
}


//var fechaGestion = new Date(av_fechaGeneraLlamada).getTime() / 1000; 
var fechaGestion = '';
if (parseInt(scLlamadas_fechaCreacion)>0){
	var fechaGestionx= new Date(parseInt(scLlamadas_fechaCreacion) * 1000);
	var year1 = fechaGestionx.getFullYear();
  	var month1 = fechaGestionx.getMonth()+1;
  	var dia = fechaGestionx.getDate();
// Will display time in 10:30:23 format
	fechaGestion = year1 + lpad(month1,'0',2) + lpad(dia,'0',2);
}

var fechaGestion2= new Date(parseInt(scLlamadas_fechaCreacion) * 1000);
if (fechaGestion2>0){
	var year = fechaGestion2.getFullYear();
  	var month = fechaGestion2.getMonth()+1;
  	var dia = fechaGestion2.getDate();
// Will display time in 10:30:23 format
	fechaGestion3 = year + lpad(month,'0',2) + lpad(dia,'0',2);
}

var nuevaGestion = fechaGestion2;
nuevaGestion.setDate(fechaGestion2.getDate()+3);
var year = nuevaGestion.getFullYear();
  	var month = nuevaGestion.getMonth()+1;
  	var dia = nuevaGestion.getDate();
// Will display time in 10:30:23 format
	nuevaGestion1 = year + lpad(month,'0',2) + lpad(dia,'0',2);

var compromisoConcat = anioCompromiso + mesCompromiso + diaCompromiso;

var fechaAsignaCon = anioAsignacion + mesAsignacion + diaAsignacion;
var fechaAsignaMaxConcat = anioAsignacionMax + mesAsignacionMax + diaAsignacionMax;


var fechaAsignaConcat = fechaAsignaCon;
	if (fechaAsignaCon == null){
	fechaAsignaConcat = fechaAsignaMaxConcat;
}

var compromisoPago = '';
	if (compromisoConcat != 0){
		compromisoPago = compromisoConcat;
}
else {compromisoPago = nuevaGestion1}

var tipoContacto = 'T';
var respuesta = '';

// ===============================
// 1️ Mapa principal (ruta2)
// ===============================
var mapaRuta2 = {
  'PAGA EN FECHA': '05',
  'ABONO CUOTA': '33',
  'CONFIRMACION DE PAGO': '32',
  'DIFERIDO PAGO MINIMO': '25',
  'REESTRUCTURACION': '38',
  'REFINANCIAMIENTO OPB': '39',
  'DIFERIDO FLEX PLUS': '27',
  'NEGOCIACION EN CURSO ALIVIO': '12',
  'NO QUIERE PAGAR': '29',
  'RECLAMO PENDIENTE': '06',
  'OFRECIMIENTO INCUMPLIDO': '36',
  'NO DESEA ACUERDO': '22',
  'MENSAJE A TERCERO': '03',
  'GESTION A TERCEROS': '03',
  'NO CONTACTADO CAMPO': '17',
  'MENSAJE VOZ GRABADORA': '18',
  'NO CONTACTADO TLFN': '21',
  'FALLECIDO': '20',
  'SOCIO FUERA PAIS': '01',
  'ILOCALIZABLE': '02',
  'ILOCALIZABLE EN CAMPO': '19',
  'WHATSAPP ENVIADO': '35',
  'WHATSAPP LEIDO': '35',
  'WHATSAPP RESPONDIDO': '35',
  'Mail Enviado': '37',
  'VOLVER A LLAMAR': '16',
  'CONTESTA Y CIERRA': '16',
  'TELEFONO EQUIVOCADO NO CORRESPONDE': '04',
  'VALORES A PAGAR ERRONEOS': '06'
};

// ===============================
// 2️ Combinaciones prioritarias
// ===============================
if (
   (scLlamadas_ruta1 == 'CONTACTO DIRECTO' &amp;&amp; scLlamadas_texto == 'WHATSAPP ENVIADO')
) {
   respuesta = '24';
}

else if (
   (scLlamadas_ruta1 == 'CONTACTO DIRECTO' &amp;&amp; scLlamadas_texto == 'WHATSAPP RESPONDIDO')||
   (scLlamadas_ruta1 == 'CONTACTO DIRECTO' &amp;&amp; scLlamadas_texto == 'WHATSAPP LEIDO')||
   (scLlamadas_ruta1 == 'CONTACTO DIRECTO' &amp;&amp; scLlamadas_texto == 'WHATSAPP ENVIADO')
) {
   respuesta = '35';
}

// ===============================
// 3️ SIN CONTACTO
// ===============================
else if (
   scLlamadas_ruta1 == 'SIN CONTACTO' &amp;&amp;
   (
     scLlamadas_texto == 'ILOCALIZABLE' ||
     scLlamadas_texto == 'CLIENTE NO CONTESTA LA LLAMADA' ||
     scLlamadas_texto == 'WHATSAPP NO LEIDO' ||
     scLlamadas_ruta2 == null ||
     scLlamadas_ruta2 == ''
   )
) {
   respuesta = '02';
}

// ===============================
// 4️ REINTENTOS
// ===============================
else if (
   (scLlamadas_texto != null &amp;&amp; scLlamadas_texto.indexOf('REINTENTOS') == 0) ||
   scLlamadas_texto == 'ILOCALIZABLE'
) {
   respuesta = '02';
}



// ===============================
// 6️ Buscar en mapa
// ===============================
else if (mapaRuta2[scLlamadas_ruta2] != null) {
   respuesta = mapaRuta2[scLlamadas_ruta2];
}
var codigoResp = '   ';
var codigoGest= '01';

var identificacion = rpad(cre_cedula,' ',16);
var operacion = rpad(cre_factura,' ',6);
var fechaAsignacionArchivo = rpad(fechaAsignaConcat,' ',8);
var tlfContacto = rpad(codigoGest,' ',2);
var fechaLlamada = rpad(fechaGestion,' ',8);
var codCobranzas = rpad(respuesta,' ',2);
var obs1 = respuesta1c;
if (scLlamadas_ruta1 =='Mail Enviado'){
	obs1 = respuesta1c;
}
else if (
