  <step>
    <name>Split fields 2 2</name>
    <type>ScriptValueMod</type>
    <description>Antes partia scLlamadas_ruta3 por '|'. Ahora ese campo ya no existe (viene de Mongo), asi que se extrae la fecha de compromiso directamente del texto de resumen buscando un patron de fecha entre corchetes. 'cualquier' queda vacio porque no hay campo equivalente en Mongo a la primera mitad de ruta3.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

// Antes, la fecha de compromiso venia directo en scLlamadas_ruta3 separada
// por '|' (Split fields). Ese campo ya no existe (ahora viene de Mongo), asi
// que se extrae buscando un patron de fecha entre corchetes dentro del texto
// de resumen (scLlamadas_texto / cubGC_resumen). Soporta los 2 formatos que
// aparecen en el resumen: [ yyyy-mm-dd ] y [ dd-mm-yyyy ].
// Si el contenido entre corchetes no es una fecha (ej: '[1]' o un correo),
// no hace match y fechaCompromiso queda vacio; mas adelante el script ya
// existente usa el respaldo automatico (fecha de gestion + 3 dias).

var cualquier = '';
var fechaCompromiso = '';

if (scLlamadas_texto != null) {
	var m = scLlamadas_texto.match(/\[\s*(\d{4})-(\d{2})-(\d{2})\s*\]/);
	if (m != null) {
		fechaCompromiso = m[1] + '-' + m[2] + '-' + m[3];
	} else {
		m = scLlamadas_texto.match(/\[\s*(\d{2})-(\d{2})-(\d{4})\s*\]/);
		if (m != null) {
			fechaCompromiso = m[3] + '-' + m[2] + '-' + m[1];
		}
	}
}
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>cualquier</name>
        <rename>cualquier</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>fechaCompromiso</name>
        <rename>fechaCompromiso</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
