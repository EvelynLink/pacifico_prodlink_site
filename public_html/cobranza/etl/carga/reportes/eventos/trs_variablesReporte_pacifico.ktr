    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var Fecha=new Date(fecha).getTime() / 1000;
var FechaFin=new Date(fechaFin).getTime() / 1000;

var Fechahoy4pm= Fecha + 57600;

var FechaJ=new Date(fecha);

var fechaSola=fecha;


var fechaHoy = new Date();
var diaDeHoy = '';
var diaSemana = fechaHoy.getDay();
var sabado = Fecha;
var ayer = Fecha - 24*60*60;
var antiayer = Fecha - 2*24*60*60;
switch (diaSemana){
case '1': //lunes
sabado = Fecha - 2*24*60*60;
ayer = Fecha - 3*24*60*60;
antiayer = Fecha - 4*24*60*60;
break;
case '2': //martes
ayer = Fecha - 3*24*60*60;
antiayer = Fecha - 4*24*60*60;
break;
case '3': //martes
antiayer = Fecha - 4*24*60*60;
break;
}

                    var Fechahoy4pm= Fecha + 57600;

var Fechaayer= Fecha - 24*60*60;
if (diaSemana == '1'){
    Fechaayer = Fecha - 3*24*60*60;
}
var Fechaayer4pm= Fechaayer + 57600;

var a = new Date(sabado * 1000);
var anioSabado = a.getFullYear();
var	mesSabado = ('0' + (a.getMonth() + 1)).slice(-2); 
var	diaSabado = ('0' + (a.getDate())).slice(-2);  
var fechaTrs = mesSabado+diaSabado;

var a2 = new Date(ayer * 1000);
var anioSabado2 = a2.getFullYear();
var mesSabado2 = ('0' + (a2.getMonth() + 1)).slice(-2); 
var diaSabado2 = ('0' + (a2.getDate())).slice(-2);  
var fechaTrsAyer = mesSabado2+diaSabado2;

var a3 = new Date(antiayer * 1000);
var anioSabado3 = a3.getFullYear();
var mesSabado3 = ('0' + (a3.getMonth() + 1)).slice(-2); 
var diaSabado3 = ('0' + (a3.getDate())).slice(-2);  
var fechaTrsAntiayer = mesSabado3+diaSabado3;


var start = new Date(FechaJ.getFullYear(), 0, 0);
var diff = FechaJ - start;
var oneDay = 1000 * 60 * 60 * 24;
var fechaJuliana = Math.floor(diff / oneDay);

var fechaJuli2 = lpad(fechaJuliana,'0',3);



var nombreArchivo = '/home/pacifico/public_html/ETL/Pacifico/Procesamiento/Reportes/Generado/'+'CO1'+'MCE'+'LKD'+'.'+fechaJuli2;
var nombreArchivoEncrip = '/home/pacifico/public_html/ETL/Pacifico/Procesamiento/Reportes/Encriptado/'+'CO1'+'MCE'+'LKD'+'.'+fechaJuli2+'.PGP';
var nombreCO1 = 'CO1'+'MCE'+'LKD'+'.'+fechaJuli2+'.PGP';

var nombreRecuperacion = 'RECUPERACION_CARTERA-LINKDESIGN_TC_'+fechaTrs+'.XLSX.PGP';
var nombreRecuperacionAyer = 'RECUPERACION_CARTERA-LINKDESIGN_TC_'+fechaTrsAyer+'.XLSX.PGP';
var nombreRecuperacionAntiayer = 'RECUPERACION_CARTERA-LINKDESIGN_TC_'+fechaTrsAntiayer+'.XLSX.PGP';


var directorioHoy = '/home/pacifico/public_html/ETL/Pacifico/Procesamiento/Recuperacion/Encriptados/'+ nombreRecuperacion;
var directorioAyer = '/home/pacifico/public_html/ETL/Pacifico/Procesamiento/Recuperacion/Encriptados/'+ nombreRecuperacionAyer;
var directorioAntiayer = '/home/pacifico/public_html/ETL/Pacifico/Procesamiento/Recuperacion/Encriptados/'+ nombreRecuperacionAntiayer;

var nombreDelDia = 'ASIGNACION_LINKDESIGN_'+fechaTrs+'.XLSX.PGP';
var nombreDelDiaAyer = 'ASIGNACION_LINKDESIGN_'+fechaTrsAyer+'.XLSX.PGP';
var nombreDelDiaAntiayer = 'ASIGNACION_LINKDESIGN_'+fechaTrsAntiayer+'.XLSX.PGP';

//var query = 'SELECT * FROM scllamadas WHERE scLlamadas_fechaCreacion BETWEEN ' + Fechaayer4pm + ' and ' + Fechahoy4pm;

var query = "SELECT c.cobCarteraRamas_carteraIdfk, d.cre_usUsuarios_id, d.cre_factura as factura, d.cre_periodo, d.cre_cedula, d. cre_carteraId, s.scLlamadas_fechaCreacion, s.scLlamadas_callerIdReportado, s.scLlamadas_texto, s.scLlamadas_ruta0, s.scLlamadas_ruta1, s.scLlamadas_ruta2, s.scLlamadas_ruta3, s.scLlamadas_usuarioId, s.scLlamadas_id, s.scLlamadas_eventoId, u.usUsuarios_cedula  from scllamadas s INNER JOIN scramas r ON r.scRamas_nombre=s.scLlamadas_ruta0 INNER JOIN ususuarios u ON s.scLlamadas_usuarioId=u.usUsuarios_id INNER JOIN cobcarteraramas c ON c.cobCarteraRamas_ramaIdfk=r.scRamas_id INNER JOIN cbcreditos d ON d.cre_usUsuarios_id = u.usUsuarios_id WHERE s.scLlamadas_fechaCreacion BETWEEN " + Fechaayer4pm + " and " + Fechahoy4pm + " AND s.scLlamadas_ruta1 &lt;&gt; 'Conexión exitosa' and s.scLlamadas_texto NOT LIKE 'Llamada desprogramada%' AND scLlamadas_texto &lt;&gt; 'WHATSAPP NO ENVIADO' AND scLlamadas_ruta2 &lt;&gt; 'Mail No Enviado' AND c.cobCarteraRamas_carteraIdfk IN ('2120','2121')";


var queryCubo = "{cubGC_fechaGestion: {$gte:" + Fechaayer4pm + " , $lte:" + Fechahoy4pm + "}, cubGC_carteraId: {$in: ['2120', '2121']},cubGC_tipificacion_respuesta2: {$nin: ['WHATSAPP NO ENVIADO', 'WHATSAPP CON ERROR', 'Mail No Enviado']}, cubGC_resumen: {$not: {$regex: '^Llamada desprogramada'}}}";
                </jsScript_script>
      </jsScript>
    </jsScripts>
